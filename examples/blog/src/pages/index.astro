---
import { getCollection } from "astro:content";

const posts = (await getCollection("posts")).sort((a, b) =>
  String(b.data.published ?? "").localeCompare(String(a.data.published ?? "")),
);
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>omgbase example blog</title>
    <style>
      :root {
        color-scheme: light;
        --ink: #1a1a1a;
        --muted: #5c5c5c;
        --line: #e6e2da;
        --paper: #f7f4ef;
        --accent: #0b5fff;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, serif;
        background:
          radial-gradient(circle at top left, #fff8e8, transparent 40%),
          linear-gradient(180deg, #fbfaf7, var(--paper));
        color: var(--ink);
        min-height: 100vh;
      }
      main {
        width: min(42rem, calc(100% - 2rem));
        margin: 0 auto;
        padding: 4rem 0 6rem;
      }
      .brand {
        font-family: "Avenir Next", "Segoe UI", sans-serif;
        font-size: 0.85rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--muted);
        margin: 0 0 0.75rem;
      }
      h1 {
        font-size: clamp(2.4rem, 6vw, 3.6rem);
        line-height: 1.05;
        margin: 0 0 0.75rem;
        letter-spacing: -0.03em;
      }
      .lede {
        color: var(--muted);
        font-size: 1.15rem;
        margin: 0 0 2.5rem;
        max-width: 34rem;
      }
      ul {
        list-style: none;
        padding: 0;
        margin: 0;
        border-top: 1px solid var(--line);
      }
      li {
        border-bottom: 1px solid var(--line);
        padding: 1.25rem 0;
      }
      a {
        color: inherit;
        text-decoration: none;
      }
      a:hover { color: var(--accent); }
      .title {
        font-size: 1.35rem;
        margin: 0 0 0.35rem;
      }
      .meta {
        color: var(--muted);
        font-family: "Avenir Next", "Segoe UI", sans-serif;
        font-size: 0.85rem;
      }
    </style>
  </head>
  <body>
    <main>
      <p class="brand">omgbase × Astro</p>
      <h1>Example blog</h1>
      <p class="lede">
        Posts are selected from an omgbase vault with OQX. Vault-relative Markdown
        links between published docs become site routes at build time — open
        <a href="/blog/hello/">Hello</a> and compare source vs HTML.
      </p>
      <ul>
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.data.slug}/`}>
              <p class="title">{post.data.title}</p>
              <p class="meta">
                {post.data.published ? String(post.data.published) : "undated"}
                {" · "}
                {post.data.description ?? post.data.path}
              </p>
            </a>
          </li>
        ))}
      </ul>
    </main>
  </body>
</html>
