{
  "name": "@omgbase/astro",
  "version": "0.1.0",
  "description": "Astro Content Loader and helpers to use omgbase as a CMS",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "echo 'no lint yet'"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@omgbase/core": "^0.5.0",
    "@omgbase/sync": "^0.4.2"
  },
  "peerDependencies": {
    "astro": ">=5.0.0"
  },
  "devDependencies": {
    "astro": "^7.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
