{
  "name": "omgbase-astro-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Astro tooling to use omgbase as a CMS for static sites",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "build": "pnpm -r --filter @omgbase/astro build",
    "typecheck": "pnpm -r --filter @omgbase/astro typecheck",
    "test": "pnpm -r --filter @omgbase/astro test",
    "lint": "pnpm -r --filter @omgbase/astro lint"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "sharp"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
